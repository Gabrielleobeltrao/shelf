PORT=4001
# Em produção: a URL pública do frontend (ex: https://shelf.vercel.app)
CLIENT_URL=http://localhost:5183

# Connection string do cluster no MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shelf?retryWrites=true&w=majority

# Gere um valor aleatório, ex: openssl rand -base64 32
# Em produção use um valor DIFERENTE do de desenvolvimento.
BETTER_AUTH_SECRET=
# Em produção: a própria URL pública deste backend (ex: https://api.seudominio.com)
BETTER_AUTH_URL=http://localhost:4001

# Defina como "production" no host de produção (Coolify) — habilita cookies
# de sessão sameSite=none;secure, necessários pois o frontend (Vercel) e o
# backend ficam em domínios diferentes. Deixe vazio em desenvolvimento.
NODE_ENV=
